acl "clientes-internos" {
    127.0.0.1;
    192.168.50.0/24;
};

options {
    directory "/var/cache/bind";

    listen-on {
        127.0.0.1;
        192.168.50.1;
    };

    listen-on-v6 { none; };

    recursion yes;
    allow-query { clientes-internos; };
    allow-recursion { clientes-internos; };

    forwarders {
        8.8.8.8;
        8.8.4.4;
    };
};
