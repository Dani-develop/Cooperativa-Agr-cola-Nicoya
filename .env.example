# Copiar a .env solo al llegar al bloque de Docker en la VM Ubuntu.
# .env está excluido de Git; no es un archivo cifrado. Restringir sus permisos.
# Referencias verificadas en el registro oficial; la prueba en VM se registra en T03.
WORDPRESS_IMAGE=wordpress:7.1.3-php8.3-apache@sha256:d42f63cb89ad0eab272c4b393164e63830d0df270009907919f7dcce52b1a20b
MARIADB_IMAGE=mariadb:11.8.9@sha256:f16d7a344413e519dff518f27bdb221388f84b0d274c97c4fb5f2cb0dc1b34fa

# Valores propuestos; registrar los reales en docs/inventario.md.
PROJECT_DOMAIN=cooperativa.internal
SERVER_IP=192.168.50.1
CLIENT_IP=192.168.50.2
HTTP_BACKEND_PORT=8082

# Usar exactamente la misma base/usuario en aplicación y BD.
DB_NAME=cooperativa_wp
DB_USER=cooperativa_web

# Generar dos contraseñas diferentes fuera del repositorio. Nunca usar root en WP.
# Los valores vacíos detienen Compose para impedir un arranque accidental.
DB_ROOT_PASSWORD=
DB_PASSWORD=

# Variables de planificación para configurar y documentar el respaldo.
BACKUP_DIR=/srv/respaldos-cooperativa
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
